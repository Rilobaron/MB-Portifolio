# Variáveis de ambiente para envio do formulário de contato via Resend
# (em uma futura função serverless / Supabase Edge Function).
# Nunca comitar o arquivo .env real. Nunca expor essas chaves no frontend.

# Chave secreta da API do Resend (server-side)
RESEND_API_KEY=

# E-mail remetente verificado no Resend (ex.: contato@seudominio.com)
CONTACT_FROM_EMAIL=

# E-mail que recebe as mensagens do formulário
CONTACT_TO_EMAIL=murilopereira1461@gmail.com